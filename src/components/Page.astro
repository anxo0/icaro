---
/**
 * Contenido de la página, compartido por / y /en/. La bienvenida es HTML estático (indexable) y se
 * oculta cuando hay un chat activo; el resto es la isla <IcaroApp>.
 */
import Base from '@/layouts/Base.astro';
import Wing from './Wing.astro';
import IcaroApp from './app/IcaroApp';
import { getStrings, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const strings = getStrings(lang);
const { site: t, app } = strings;
---

<Base lang={lang} strings={strings}>
  <section id="welcome" class="mx-auto mt-auto w-full max-w-3xl px-4 pt-8 pb-4 text-center sm:px-6 lg:mt-0 lg:pt-[10vh] lg:pb-6">
    <Wing size={44} class="mx-auto text-accent" />
    <p class="label mt-5">{t.hero.kicker}</p>
    <h1 class="mt-2 text-[26px] font-semibold tracking-tight text-balance sm:text-4xl">{t.hero.title}</h1>
    <p class="mt-3 text-lg text-accent-ink text-balance">{t.hero.claim}</p>
    <p class="mx-auto mt-3 max-w-xl text-[15px] leading-relaxed text-ink-2 text-pretty">{t.hero.lead}</p>
    <ul class="mt-5 hidden flex-wrap justify-center gap-2 sm:flex" aria-label="">
      {t.hero.badges.map((b) => <li class="hairline rounded-full px-3 py-1 text-xs text-ink-2">{b}</li>)}
    </ul>
    <noscript>
      <p class="hairline mt-6 rounded-xl bg-surface p-4 text-sm text-ink-2">{t.noscript}</p>
    </noscript>
  </section>

  <IcaroApp client:only="react" lang={lang} t={app}>
    <div slot="fallback" class="mx-auto w-full max-w-3xl px-4 pb-6 sm:px-6" aria-hidden="true">
      <div class="hairline h-24 animate-pulse rounded-2xl bg-surface"></div>
    </div>
  </IcaroApp>
</Base>
